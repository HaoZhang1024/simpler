+    // A6 (Ascend960DT_966B7) — measured on device 0, 2026-11-18
+    // (a6_dsv41_scheduler/build/onboard-001/resmap-probe.log):
+    //   halResMap(RES_AICORE, PROCESS_CP1, res_id) returns ONE independent
+    //   2 MiB window per res_id (A5 was 3 MiB per AIC with two AIV
+    //   sub-windows). 2 MiB == 1 MiB AIC + 1 MiB AIV under the 1C1V
+    //   topology; the AIV sub-window is INFERRED at +0x100000 (same
+    //   first-offset as A5) and not yet verified. res_id 0..63 all map;
+    //   ids >= 54 have unknown validity, so only 0..53 are mapped.
+    //   PROCESS_CP2 is rejected (rc=65534); RES_L2BUFF/RES_C2C rc=17;
+    //   RES_DBG_ADDR maps 4 KiB; RES_HSCB_AICORE maps 0x4096 B.
+    // Table is identity-indexed (slot i == res_id i window base): A6
+    // get_coreid() encoding is unmeasured, so a hardware id outside
+    // [0,54) surfaces as the consumer's out-of-range diagnostic with the
+    // raw value preserved. cond_offset_ = 0xFFFFFFFF is the GM-only
+    // sentinel: the A6 COND offset is unknown and the consumer skips all
+    // COND MMIO reads and writes in that mode.
+    bool InitA6() {
+        auto *map = reinterpret_cast<ResMapFn>(dlsym(nullptr, "halResMap"));
+        unmap_ = reinterpret_cast<ResUnmapFn>(dlsym(nullptr, "halResUnmap"));
+        if (map == nullptr || unmap_ == nullptr) {
+            std::fprintf(stderr, "halResMap/halResUnmap not found in symbol table\n");
+            unmap_ = nullptr;
+            return false;
+        }
+        constexpr uint32_t kAicCores = 54;
+        constexpr uint64_t kAivOffset = 0x100000;
+        constexpr uint32_t kMapBytes = 0x200000;
+        cond_offset_ = 0xFFFFFFFFu;
+        dmb_offset_ = 0xD0;
+        bases_.assign(kAicCores, 0);
+        for (uint32_t core = 0; core < kAicCores; ++core) {
+            res_map_info info{};
+            info.target_proc_type = PROCESS_CP1;
+            info.res_type = RES_AICORE;
+            info.res_id = core;
+            unsigned long va = 0;
+            uint32_t len = kMapBytes;
+            const int rc = map(hal_device_id_, &info, &va, &len);
+            if (rc != 0 || va == 0 || len < kAivOffset + 0x1000) {
+                std::fprintf(stderr, "halResMap core=%u rc=%d va=0x%lx len=0x%x\n", core, rc, va, len);
+                return false;
+            }
+            ++mapped_cores_;
+            bases_[core] = va;
+        }
+        return true;
+    }
+
     std::vector<uint64_t> bases_;
     ResUnmapFn unmap_ = nullptr;
     uint32_t hal_device_id_ = 0;
